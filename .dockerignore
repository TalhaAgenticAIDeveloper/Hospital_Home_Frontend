# =============================================================================
# Frontend Docker Ignore Configuration
# =============================================================================

# Dependencies (must be installed inside the container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production build output
dist/
build/

# Version control
.git/
.gitignore

# Environment files
.env.local
.env.*.local

# Editor & IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Testing & Linting cache
.eslintcache
